import React, { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import API from '../services/api';

export default function TeacherDashboard() {
  const [assignments, setAssignments] = useState([]);
  const [title, setTitle] = useState('');
  const [description, setDescription] = useState('');
  const [deadline, setDeadline] = useState('');
  const [maxMarks, setMaxMarks] = useState(100);
  const [submissions, setSubmissions] = useState([]);
  const [activeAssignId, setActiveAssignId] = useState(null);
  const [marks, setMarks] = useState({});
  const [feedback, setFeedback] = useState({});
  const navigate = useNavigate();
  const teacherName = localStorage.getItem('name') || 'Teacher';

  useEffect(() => {
    fetchAssignments();
  }, []);

  const fetchAssignments = async () => {
    try {
      const res = await API.get('/assignments');
      setAssignments(res.data);
    } catch (err) {
      console.error(err);
    }
  };

  const handleCreateAssignment = async (e) => {
    e.preventDefault();
    try {
      await API.post('/assignments', {
        course_id: 1,
        title,
        description,
        deadline: new Date(deadline).toISOString(),
        max_marks: parseInt(maxMarks),
      });
      setTitle('');
      setDescription('');
      setDeadline('');
      fetchAssignments();
    } catch (err) {
      alert(err.response?.data?.detail || 'Failed to create assignment.');
    }
  };

  const fetchSubmissions = async (assignmentId) => {
    setActiveAssignId(assignmentId);
    try {
      const res = await API.get(`/assignments/${assignmentId}/submissions`);
      setSubmissions(res.data);
    } catch (err) {
      console.error(err);
    }
  };

  const handleGrade = async (subId) => {
    try {
      await API.post(`/submissions/${subId}/grade`, {
        marks: parseInt(marks[subId] || 0),
        feedback: feedback[subId] || '',
      });
      alert('Grade submitted successfully!');
      fetchSubmissions(activeAssignId);
    } catch (err) {
      alert(err.response?.data?.detail || 'Grading failed.');
    }
  };

  const logout = () => {
    localStorage.clear();
    navigate('/login');
  };

  return (
    <div className="min-h-screen bg-slate-100 p-8">
      <div className="max-w-6xl mx-auto">
        <div className="flex justify-between items-center mb-8 bg-white p-6 rounded-xl shadow">
          <div>
            <h1 className="text-3xl font-bold text-slate-800">Teacher Portal: {teacherName}</h1>
            <p className="text-slate-500">Assignment Management & Evaluation Center</p>
          </div>
          <button onClick={logout} className="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700">Logout</button>
        </div>

        <div className="grid grid-cols-1 md:grid-cols-2 gap-8 mb-8">
          <div className="bg-white p-6 rounded-xl shadow">
            <h2 className="text-xl font-bold mb-4 text-slate-800">Create New Assignment</h2>
            <form onSubmit={handleCreateAssignment} className="space-y-4">
              <input type="text" placeholder="Assignment Title" value={title} onChange={(e) => setTitle(e.target.value)} required className="w-full p-3 border rounded-lg" />
              <textarea placeholder="Description" value={description} onChange={(e) => setDescription(e.target.value)} required className="w-full p-3 border rounded-lg" />
              <input type="datetime-local" value={deadline} onChange={(e) => setDeadline(e.target.value)} required className="w-full p-3 border rounded-lg" />
              <input type="number" placeholder="Max Marks" value={maxMarks} onChange={(e) => setMaxMarks(e.target.value)} required className="w-full p-3 border rounded-lg" />
              <button type="submit" className="w-full py-3 bg-indigo-600 text-white font-semibold rounded-lg hover:bg-indigo-700">Publish Assignment</button>
            </form>
          </div>

          <div className="bg-white p-6 rounded-xl shadow">
            <h2 className="text-xl font-bold mb-4 text-slate-800">Active Assignments</h2>
            <div className="space-y-3">
              {assignments.map((assign) => (
                <div key={assign.assignment_id} className="p-4 border rounded-lg flex justify-between items-center bg-slate-50">
                  <div>
                    <h3 className="font-semibold text-slate-800">{assign.title}</h3>
                    <p className="text-xs text-slate-500">Max Marks: {assign.max_marks}</p>
                  </div>
                  <button onClick={() => fetchSubmissions(assign.assignment_id)} className="px-3 py-1 bg-blue-600 text-white text-sm rounded hover:bg-blue-700">View Submissions</button>
                </div>
              ))}
            </div>
          </div>
        </div>

        {activeAssignId && (
          <div className="bg-white p-6 rounded-xl shadow">
            <h2 className="text-xl font-bold mb-4 text-slate-800">Submissions for Assignment #{activeAssignId}</h2>
            <div className="space-y-4">
              {submissions.map((sub) => (
                <div key={sub.submission_id} className="p-4 border rounded-lg bg-slate-50 flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0">
                  <div>
                    <p className="font-semibold">Student ID: {sub.student_id}</p>
                    <p className="text-sm text-slate-600">File: {sub.file_name} ({sub.submission_status})</p>
                    <a href={`http://localhost:8000/api/submissions/${sub.submission_id}/download`} target="_blank" rel="noreferrer" className="text-blue-600 text-sm hover:underline">Download Student File</a>
                  </div>
                  <div className="flex items-center space-x-2">
                    <input type="number" placeholder="Marks" value={marks[sub.submission_id] || ''} onChange={(e) => setMarks({ ...marks, [sub.submission_id]: e.target.value })} className="w-20 p-2 border rounded" />
                    <input type="text" placeholder="Feedback" value={feedback[sub.submission_id] || ''} onChange={(e) => setFeedback({ ...feedback, [sub.submission_id]: e.target.value })} className="p-2 border rounded" />
                    <button onClick={() => handleGrade(sub.submission_id)} className="px-4 py-2 bg-emerald-600 text-white rounded hover:bg-emerald-700">Grade</button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
